{
  "$defs": {
    "Reaction": {
      "description": "Why the friend is replying the way they are. Selects lines from the line bank.",
      "enum": [
        "opening",
        "neutral",
        "checked_in",
        "validated",
        "asked_directly",
        "encouraged_help",
        "referred",
        "follow_up",
        "dismissed",
        "advice_dump",
        "promised_secrecy",
        "secrecy_broken",
        "off_topic",
        "success",
        "fail"
      ],
      "title": "Reaction",
      "type": "string"
    }
  },
  "description": "One pre-written friend reply in the line bank (data/lines/<scenario_id>.<locale>.jsonl).",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "locale": {
      "default": "en",
      "title": "Locale",
      "type": "string"
    },
    "level": {
      "title": "Level",
      "type": "integer"
    },
    "reaction": {
      "$ref": "#/$defs/Reaction"
    },
    "bubbles": {
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Bubbles",
      "type": "array"
    },
    "fact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Fact Ids",
      "type": "array"
    },
    "cue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cue"
    },
    "tone": {
      "default": "",
      "title": "Tone",
      "type": "string"
    },
    "review_status": {
      "default": "draft",
      "enum": [
        "draft",
        "reviewed"
      ],
      "title": "Review Status",
      "type": "string"
    }
  },
  "required": [
    "id",
    "scenario_id",
    "level",
    "reaction",
    "bubbles"
  ],
  "title": "Line",
  "type": "object"
}
