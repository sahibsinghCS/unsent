# FirstReply configuration. Copy to .env and fill in what you need.
FR_ENV=dev

# --- OpenAI: used ONLY for the friend's wording (+ optional rewrites, free moderation, red-team bots) ---
# Get a key at platform.openai.com and SET A MONTHLY SPENDING LIMIT there. Without a key the app still
# works: the friend falls back to the reviewed line bank.
OPENAI_API_KEY=
OPENAI_MODEL_ACTOR=gpt-5-mini        # check what your key can use: make models
OPENAI_MODEL_JUDGE=gpt-5-mini
LLM_DAILY_BUDGET_USD=2               # app falls back to the line bank once today's estimate passes this
OPENAI_PRICE_INPUT_PER_M=0.25        # set to your model's real prices (used for the budget estimate)
OPENAI_PRICE_OUTPUT_PER_M=2.00
FR_LLM=1                             # 0 = fully offline (no LLM at all)
FR_FAKE_LLM=                         # 1 = deterministic fakes (tests set this automatically)

# --- Local components ---
FR_STUB=0
FR_STUB_ONLY=
FR_EMBED=fastembed
FR_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FR_MAX_MESSAGE_CHARS=500
FR_MAX_TURNS=16
FR_SESSION_TTL_MIN=60
PORT=8000
