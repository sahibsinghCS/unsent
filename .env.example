# FirstReply configuration. Copy to .env if you want to change defaults.
# No API keys needed: everything runs locally and free.
FR_ENV=dev
FR_STUB=0
FR_STUB_ONLY=
FR_EMBED=fastembed
FR_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FR_MAX_MESSAGE_CHARS=500
FR_MAX_TURNS=16
FR_SESSION_TTL_MIN=60
PORT=8000
